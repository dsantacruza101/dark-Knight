[Unit]
Description=Julia Pennyworth — inteligencia de amenazas (CISA KEV, avisos de Ubuntu, Node.js), solo lectura
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=dsantacruz
WorkingDirectory=/home/dsantacruz/projects/night-agent
ExecStart=/home/dsantacruz/projects/night-agent/venv/bin/python3 julia.py
Environment=PATH=/home/dsantacruz/.local/share/node-current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/night-agent.env
TimeoutStartSec=900
Nice=10
StandardOutput=journal
StandardError=journal
