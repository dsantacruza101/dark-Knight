[Unit]
Description=Radar de Spoiler (semanal) — notas de Claude sobre majors + resumen a Alfred
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dsantacruz
WorkingDirectory=/home/dsantacruz/projects/night-agent
ExecStart=/home/dsantacruz/projects/night-agent/venv/bin/python3 -m batcave.radar --specialist spoiler --weekly
Environment=PATH=/home/dsantacruz/.nvm/versions/node/v22.23.2/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/night-agent.env
TimeoutStartSec=5400
Nice=10
StandardOutput=journal
StandardError=journal
