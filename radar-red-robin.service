[Unit]
Description=Radar de Red Robin — dependencias, vulnerabilidades (OSV) y parches proactivos
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dsantacruz
WorkingDirectory=/home/dsantacruz/projects/night-agent
ExecStart=/home/dsantacruz/projects/night-agent/venv/bin/python3 -m batcave.radar --specialist red_robin
Environment=PATH=/home/dsantacruz/.local/share/node-current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/night-agent.env
TimeoutStartSec=1800
Nice=10
StandardOutput=journal
StandardError=journal
